<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches the default dark Flutter scaffold surface to avoid a bright flash before the first Flutter frame. -->
    <color name="launch_background">#202020</color>
    <!-- Static dark scheme primary: the first Flutter frame paints the launch brand mark in
         the static scheme's primary before settings load, so the native splash icon must match it. -->
    <color name="launch_brand_mark">#0088FF</color>
</resources>
